# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
/build/
/dist/
.pytest_cache/
.ruff_cache/

# OS
.DS_Store

# Claude Code scratch
.claude/worktrees/

# --- Generated track artifacts -------------------------------------------------
# Heavy, regenerable outputs. Keep track.config.json, source/ and route notes.
*.tif
*.npy
*.blend
*.blend1
*.fbx
*.kn5
# ...but the PUBLISHED, installable track folder IS committed (git-pullable into content/tracks).
!tracks/**/*.kn5

# Per-project working/output dirs (keep the folders via .gitkeep)
projects/*/data/*
projects/*/blender/*
projects/*/build/*
!projects/*/data/.gitkeep
!projects/*/blender/.gitkeep
!projects/*/build/.gitkeep
# Keep the resolved OSM street map (per-vertex street names + leg breakdown): it's reference data
# worth committing, and tracking it means the build reads it instead of re-querying live Overpass.
!projects/*/data/street_labels.json
# Keep the interior-grid connector roads (the 2nd layout's extra streets, projected) so the dual-layout
# build is reproducible from a clean checkout.
!projects/*/data/connectors.local.json

# vendor/: ignore everything EXCEPT the io_import_accsv add-on — that's the WORKING headless kn5
# exporter (scripts/ac/export_kn5_addon.py installs it), so it must be committed for a clean checkout
# to build. (The auto-cloned GPL kn5_native exporter, if ever present, stays ignored.)
vendor/*
!vendor/io_import_accsv
vendor/io_import_accsv/**/__pycache__/
vendor/io_import_accsv/**/*.pyc

# mined mod intermediates — license-sensitive, never commit to a public artifact
assets/props/_raw/
*.dds
