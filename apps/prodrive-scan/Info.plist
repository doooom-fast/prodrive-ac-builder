<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundleDisplayName</key>
	<string>Prodrive Scan</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
	<!-- Landscape only — windshield mount; ARKit depth/image are landscape-native anyway -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<!-- Capture permissions (ARKit drives the camera; CoreLocation needs GPS; CoreMotion the barometer) -->
	<key>NSCameraUsageDescription</key>
	<string>Prodrive Scan records a windshield video of the route to reconstruct how the real road looks.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Prodrive Scan logs GPS and heading so the capture can be matched to the right track on your Mac.</string>
	<key>NSMotionUsageDescription</key>
	<string>Prodrive Scan reads the barometer to measure road elevation changes along the route.</string>

	<!-- Pull session bundles off the phone via Finder (USB), the Files app, or AirDrop -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>

	<!-- ARKit is mandatory for this app -->
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arkit</string>
	</array>
</dict>
</plist>
